<Project Sdk="Microsoft.NET.Sdk">

  <!-- Exo Shaders engine service: hosts one ScsKiller (SCSKiller.Core) headlessly and speaks NDJSON over stdin/stdout.
       See CONTRACT.md. GPL-3.0-or-later with the SCSKiller additional permission (LICENSE, LICENSE-EXCEPTION.txt). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\SCSKiller.Core\SCSKiller.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ExoShaders.Service</AssemblyName>
    <RootNamespace>ExoShaders.Service</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- No window waits on a collection: blocking gen 2 collections, no background GC thread. Measured on a page visit
         (scan of 23 games): 142 MB peak private memory instead of 186 MB, the same CPU time. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- AppVersion.Current (the engine's version, its update channel and the news/rules channels it reads) comes from
         the entry assembly, so the service reports the engine version it hosts. The service's own version is
         ServiceVersion in Program.cs. -->
    <Product>Exo Shaders</Product>
    <Company>Exo Shaders (unofficial fork of SCSKiller)</Company>
    <Authors>The SCSKiller authors; Exo Shaders contributors</Authors>
    <Copyright>Copyright (C) 2026 The SCSKiller authors</Copyright>
    <Version>1.4.0-alpha.5</Version>
    <InformationalVersion>1.4.0-alpha.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
